log             prod_${label}.log

units           metal
dimension       3
boundary        p p p
atom_style      charge
newton          on

# --- edit these per run ---
variable        label    string  "bridgmanite_120gpa_3500k_run1"
variable        T        equal   3500.0
variable        model    string  "../../potentials/bridgmanite_ambient_to_lowermantle_v1.model-mliap_lammps.pt"

variable        dt       equal   0.001
variable        nsettle  equal   20000
variable        nprod    equal   1000000     # 1 ns at dt=1fs - extend if kappa hasn't plateaued
variable        rstfreq  equal   50000
variable        sflux    equal   1           # sample heat flux every step, needed for the ACF

read_restart    ../../equilibration/${label}.restart

# timestep must be set AFTER read_restart - the restart file silently
# overrides whatever you set before this line, no warning
timestep        ${dt}

pair_style      mliap unified ${model} 0
pair_coeff      * * Mg Si O

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

thermo          10
thermo_style    custom step temp pe ke etotal press pxx pyy pzz vol lx ly lz
run             0

# re-randomize velocities at the new timestep before settling in again
velocity        all create ${T} 11111 mom yes rot yes dist gaussian

thermo          1000
thermo_style    custom step temp pe ke etotal press pxx pyy pzz vol lx ly lz

fix             SETTLE all nvt temp ${T} ${T} 0.1
run             ${nsettle}
unfix           SETTLE

velocity        all zero linear
reset_timestep  0

compute         myKE      all ke/atom
compute         myPE      all pe/atom
compute         myStress  all stress/atom NULL virial
compute         flux      all heat/flux myKE myPE myStress

variable        Jx equal c_flux[1]/vol
variable        Jy equal c_flux[2]/vol
variable        Jz equal c_flux[3]/vol

thermo          1000
thermo_style    custom step temp pe ke etotal press pxx pyy pzz vol v_Jx v_Jy v_Jz

fix             HF all ave/time ${sflux} 1 ${sflux} v_Jx v_Jy v_Jz file heatflux_${label}.dat

restart         ${rstfreq} ${label}.restart1 ${label}.restart2

# weaker thermostat damping here than during SETTLE - a tight Tdamp during
# production perturbs the dynamics you're actually trying to measure
fix             PROD all nvt temp ${T} ${T} 1.0
run             ${nprod}
unfix           PROD
unfix           HF

write_data      ${label}_final.data nocoeff
write_restart   ${label}_final.restart
